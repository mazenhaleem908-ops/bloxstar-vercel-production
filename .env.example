# BloxStar production environment (server-side only — never expose in the browser)

# PostgreSQL (Neon compatible). Example:
# postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/bloxstar?sslmode=require
DATABASE_URL=

# Resend API key. The ONLY email provider. Server-side only.
RESEND_API_KEY=

# Random secret used to hash OTP codes and session tokens. Min 16 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public API base used by the frontend. Same-origin in production.
BLOXSTAR_API_URL=https://www.bloxistar.com

# Comma-separated admin emails seeded into admin_emails
ADMIN_EMAILS=business@bloxistar.com

# Optional: uniform sale discount applied to GAG / Adopt Me / MM2 (0 = no discount)
BLOXSTAR_SALE_DISCOUNT=0
